# 标书智能体 — COS 上传临时凭证模板
#
# 说明：
# 1. 本文件仅用于 ima 云端知识库的 COS 上传流程，不含后端配置。
#    后端配置（KB_BACKEND / KB_PUBLIC_ID 等）请见根目录 .env.example
# 2. 所有值均为空/占位符，不会生效。
# 3. 真实凭证由 ima-mcp 的 create_media 工具返回，有效期通常只有数小时。
# 4. 复制本文件为 .env 后填入真实凭证，使用完成后立即删除或清空。
# 5. 切勿将含真实凭证的 .env 文件提交到 Git 仓库！
# 6. .env 文件默认已被 .gitignore 忽略，如果不确定请检查 .gitignore。
#
# 用法示例：
#   cd scripts
#   cp .env.example .env
#   # 编辑 .env 填入 create_media 返回的临时凭证
#   python upload_pdf.py --file ../seeds/标书核心法规汇编_v1.0.md --cos-key "YOUR_COS_KEY"
#   # 使用完成后
#   rm .env

# === 通用 COS 凭证 ===
COS_SECRET_ID=
COS_SECRET_KEY=
COS_TOKEN=
COS_BUCKET=ima-media-prod-1258344701
COS_REGION=ap-shanghai

# === 单文件上传（cos_upload.py）额外需要 ===
COS_KEY=
COS_START_TIME=
COS_EXPIRED_TIME=

# === ima 知识库 ID（可选，仅用于脚本日志显示） ===
IMA_KNOWLEDGE_BASE_ID=
