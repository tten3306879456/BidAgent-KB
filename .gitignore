# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# ChromaDB runtime data
chroma_db/
chroma_db_*

# Environment variables
.env

# Temporary upload manifests containing COS credentials
upload_manifest*.json
*_upload_manifest.json
cos_manifest*.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.bak

# HTML preview files (generated from .md, not source code)
docs/*.html
test/*.html

# Temporary conversion/fix scripts
test/convert_*.py
test/fix_*.py
scripts/_*.py

# Local knowledge base data (user private data)
kb_data/

# Runtime sync results (contains local paths, regenerated on each run)
scripts/kb_sync_result.json

# Runtime config generated by setup_wizard/kb_setup (user-specific, not source)
scripts/kb_config.json

# Local test data (generated by kb_init.py during testing)
kb_test_data/

# Cloud KB runtime data (local search index, sync logs)
scripts/01_云端知识库/同步日志/

# WorkBuddy workspace data (user-specific, not version controlled)
.workbuddy/
BidAgent-KB-部署包.zip
