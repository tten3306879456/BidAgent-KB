# ============================================================
# 标书智能体知识库 — 后端配置环境变量模板
#
# 本文件用于配置知识库后端类型和连接参数。
# COS 上传临时凭证请见 scripts/.env.example
# ============================================================

# --- 后端选择 ---
# 可选值: local_search(默认,零依赖) / ima(云端) / both(混合) / chromadb(高级)
KB_BACKEND=local_search

# --- 本地检索后端 (local_search) ---
# 无需额外配置，自动扫描种子目录
# 可选: 启用PDF支持需 pip install PyPDF2
# 可选: 启用Word支持需 pip install python-docx

# --- ima 云端后端 ---
# 公共知识库ID（法规/废标模式/标书模板，开源共享，从README获取）
KB_PUBLIC_ID=
# 私有知识库ID（用户自建，存放个人补充内容）
KB_PRIVATE_ID=
# 知识库根路径
KB_BASE_PATH=./kb_data

# --- ChromaDB 高级后端 (可选) ---
# 如需语义搜索能力，设置 KB_BACKEND=chromadb
# 需安装: pip install chromadb sentence-transformers
# 首次运行下载嵌入模型(~90MB)，之后离线可用
KB_CHROMA_DIR=chroma_db
KB_CHROMA_COLLECTION=bid_assistant_kb
KB_EMBEDDING_MODEL=all-MiniLM-L6-v2
