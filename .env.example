# ============================================================
# 标书智能体知识库 — 后端配置环境变量模板
#
# 本文件用于配置知识库后端类型和连接参数。
# COS 上传临时凭证请见 scripts/.env.example
# ============================================================

# --- 后端选择 ---
# 可选值: local_search(默认,零依赖) / ima(云端) / both(混合) / chromadb(高级)
KB_BACKEND=local_search

# --- 本地检索后端 (local_search) ---
# 无需额外配置，自动扫描种子目录
# 可选: 启用PDF支持需 pip install PyPDF2
# 可选: 启用Word支持需 pip install python-docx

# --- ima 云端后端 ---
# 公共知识库ID（法规/废标模式/标书模板，开源共享，从README获取）
KB_PUBLIC_ID=
# 私有知识库ID（用户自建，存放个人补充内容）
KB_PRIVATE_ID=
# 知识库根路径
KB_BASE_PATH=./kb_data

# --- ChromaDB 高级后端 (可选) ---
# 如需语义搜索能力，设置 KB_BACKEND=chromadb
# 需安装: pip install chromadb sentence-transformers
# 首次运行下载嵌入模型(~1.3GB 中文优化模型)，之后离线可用
KB_CHROMA_DIR=chroma_db
KB_CHROMA_COLLECTION=bid_assistant_kb
KB_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# --- COS 上传配置 (ima 云端上传时必填) ---
# 临时凭证通过 ima-mcp create_media 获取，有效期数小时
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=ima-media-prod-1258344701
COS_REGION=ap-shanghai

# ============================================================
# 消息推送渠道配置 (可选)
# 配置后可通过 python scripts/channel_notify.py test 测试
# ============================================================

# --- 飞书 (Feishu/Lark) ---
# Webhook 机器人推送，至少填写 FEISHU_WEBHOOK_URL 即可启用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=

# --- 钉钉 (DingTalk) ---
# Webhook 机器人推送，至少填写 DINGTALK_WEBHOOK_URL 即可启用
# DINGTALK_APP_SECRET 同时用作机器人加签密钥 (SEC 开头)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_WEBHOOK_URL=

# --- 企业微信 (WeCom) ---
# 应用消息推送，需填写 Corp ID + Secret + Agent ID
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# --- 微信公众号 (WeChat OA) ---
# 客服消息推送，需填写 App ID + App Secret
# Token / EncodingAESKey 用于消息验签加解密 (接收消息时需要)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
